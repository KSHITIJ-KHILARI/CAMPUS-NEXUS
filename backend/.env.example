# ==========================================
# CAMPUS NEXUS - ENVIRONMENT CONFIGURATION
# ==========================================

# Database
DATABASE_URL=postgresql://campus_nexus:campus_nexus_pass@localhost:5432/campus_nexus

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=GENERATE_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment
ENVIRONMENT=development
ALLOWED_HOSTS=["*"]

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ==========================================
# SUPABASE (OPTIONAL - FOR DEPLOYMENT)
# ==========================================

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your-supabase-secret-key
# SUPABASE_ANON_KEY=your-supabase-anon-key

# ==========================================
# AI / LLM - SINGLE CENTRAL KEY
# ==========================================

NEXUS_API_KEY=YOUR_NEXUS_API_KEY_HERE

# AI provider
LLM_PROVIDER=openrouter

# OpenRouter endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

LLM_MODEL=minimax/minimax-m3:free

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# ==========================================
# RATE LIMITING
# ==========================================

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900

# ==========================================
# FILE UPLOAD
# ==========================================

MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=INFO
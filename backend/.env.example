# ==========================================
# CAMPUS NEXUS - ENVIRONMENT CONFIGURATION
# ==========================================

# Database
# Note: Campus Nexus V2 uses Firebase/Firestore for all database operations.
# See firebase configuration variables in the frontend or inject via Google Cloud ADC.



# Environment
ENVIRONMENT=development
ALLOWED_HOSTS=["*"]

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]


# ==========================================
# AI / LLM - SINGLE CENTRAL KEY
# ==========================================

NEXUS_API_KEY=YOUR_NEXUS_API_KEY_HERE

# AI provider
LLM_PROVIDER=openrouter

# OpenRouter endpoint
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

LLM_MODEL=minimax/minimax-m3:free

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# ==========================================
# RATE LIMITING
# ==========================================

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900

# ==========================================
# FILE UPLOAD
# ==========================================

MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=INFO
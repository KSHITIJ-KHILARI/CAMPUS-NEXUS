# API Configuration
NEXT_PUBLIC_API_URL=https://api.campus-nexus.somaiya.edu
NEXT_PUBLIC_WS_URL=wss://ws.campus-nexus.somaiya.edu
NEXTAUTH_URL=http://localhost:3000

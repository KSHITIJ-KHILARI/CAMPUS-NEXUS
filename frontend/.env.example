# ==========================================
# CAMPUS NEXUS FRONTEND — Environment Variables
# ==========================================
# Copy this file to .env.local and fill in your values.
# For production (Vercel), set these in the deployment platform settings.

# Firebase Configuration (from Firebase Console > Project Settings > Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Emulators (local development only — do NOT enable in production)
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Backend API
NEXT_PUBLIC_API_URL=https://campus-nexus-6z4h.onrender.com/api/v1
NEXT_PUBLIC_WS_URL=wss://campus-nexus-6z4h.onrender.com/ws

# MapLibre / MapTiler
NEXT_PUBLIC_MAPTILER_API_KEY=your-maptiler-api-key

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-secure-nextauth-secret-here

# AI (server-side only — do NOT prefix with NEXT_PUBLIC_)
# GEMINI_API_KEY=your-gemini-api-key
# OLLAMA_BASE_URL=http://127.0.0.1:11434

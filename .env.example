# ==========================================
# CAMPUS NEXUS - ENVIRONMENT CONFIGURATION
# ==========================================

# Central AI API Key (OpenRouter or OpenAI)
NEXUS_API_KEY=YOUR_NEXUS_API_KEY_HERE

# Database
# Note: Campus Nexus V2 uses Firebase/Firestore. No PostgreSQL or Redis is required.


# AI Configuration
LLM_PROVIDER=openrouter
LLM_MODEL=minimax/minimax-m3:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1



# Environment & Networking
ENVIRONMENT=development
DEBUG=false
ALLOWED_HOSTS=["*"]
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Frontend Public Variables
NEXT_PUBLIC_API_URL=https://campus-nexus-6z4h.onrender.com/api/v1
NEXT_PUBLIC_WS_URL=wss://campus-nexus-6z4h.onrender.com/ws
NEXT_PUBLIC_MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY_HERE


# ==========================================
# CAMPUS NEXUS - ENVIRONMENT CONFIGURATION
# ==========================================

# Central AI API Key (OpenRouter or OpenAI)
NEXUS_API_KEY=YOUR_NEXUS_API_KEY_HERE

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://campus_nexus:your_db_password@localhost:5432/campus_nexus

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Configuration
LLM_PROVIDER=openrouter
LLM_MODEL=minimax/minimax-m3:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Security
SECRET_KEY=GENERATE_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment & Networking
ENVIRONMENT=development
DEBUG=false
ALLOWED_HOSTS=["*"]
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY_HERE

